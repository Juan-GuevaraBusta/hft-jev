# Copia este archivo a `.env` (ignorado por git) y rellena los valores.
# Nunca commitees `.env` ni pegues claves en chats, issues o capturas.

# --- Alpaca (ADR-003, ADR-004) ---
# Solo claves de PAPER TRADING. No generes claves de live hasta cumplir el criterio de ADR-004.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Interruptor explícito de dinero real. Cualquier valor distinto de "true" deja el sistema en paper.
ALPACA_LIVE_TRADING_ENABLED=false

# --- OpenRouter (ADR-001) ---
# Sin saldo cargado: solo modelos gratuitos.
OPENROUTER_API_KEY=

# --- LangSmith (ADR-001) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hft-jev

# --- Langfuse Cloud (ADR-001) ---
# Host según la región elegida: https://us.cloud.langfuse.com (US) o https://cloud.langfuse.com (EU)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
